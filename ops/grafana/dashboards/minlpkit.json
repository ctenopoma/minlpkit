{
  "uid": "minlpkit-opsops",
  "title": "minlpkit OpsOps",
  "tags": [
    "minlpkit"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "campaign",
        "label": "campaign",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(opt_gap, opt_campaign_id)",
        "refresh": 2,
        "includeAll": true,
        "multi": false,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Gap(双対ギャップ)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "opt_gap{opt_campaign_id=~\"$campaign\"}",
          "legendFormat": "{{opt_run_id}} {{opt_axis_off}}{{opt_axis_instance}}",
          "interval": "1s"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Primal / Dual bound",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    4,
                    4
                  ]
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "opt_primal{opt_campaign_id=~\"$campaign\"}",
          "legendFormat": "primal {{opt_run_id}}",
          "interval": "1s"
        },
        {
          "refId": "B",
          "expr": "opt_dual{opt_campaign_id=~\"$campaign\"}",
          "legendFormat": "dual {{opt_run_id}}",
          "interval": "1s"
        }
      ]
    },
    {
      "id": 3,
      "type": "logs",
      "title": "Suggestions(ライブラリからの提案 = verdicts)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"minlpkit\"} | opt_event = `verdict`"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "探索ノード数",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "opt_nodes{opt_campaign_id=~\"$campaign\"}",
          "legendFormat": "{{opt_run_id}} {{opt_axis_off}}{{opt_axis_instance}}",
          "interval": "1s"
        }
      ]
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Run ログ(完了サマリ。trace_id から Tempo のトレースへ)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"minlpkit\"} | opt_event = `run_finished`"
        }
      ]
    }
  ]
}
